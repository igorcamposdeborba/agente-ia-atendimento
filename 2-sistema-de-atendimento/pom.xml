<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.millenium</groupId>
    <artifactId>millenium-agente-ia</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>millenium-agente-ia</name>
    <description>Servidor MCP (Fase 1 - PoC Excel) para os agentes de atendimento da Millenium</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.2</spring-ai.version>
        <poi.version>5.3.0</poi.version>
        <!-- Alinhado ao que esta disponivel no cache local (ambiente offline). -->
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- MCP server via stdio (Claude Desktop lanca o processo localmente) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>

        <!-- Necessario pela autoconfiguracao do MCP server (Spring AI 1.1.x referencia
             StandardServletEnvironment). Nao sobe servidor web: web-application-type=none. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Leitor de Excel (Fase 1) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- recursos padrao (application.properties, logback) + planilhas ficticias em
                 src/main/resources/fonte/*.xlsx. filtering=false: NUNCA aplicar resource-filtering,
                 senao o Maven poderia corromper os .xlsx (binarios) ao tentar trocar tokens. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- wiki editavel na raiz do projeto, empacotada no jar como fallback (classpath:wiki/) -->
            <resource>
                <directory>wiki</directory>
                <targetPath>wiki</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Permite rodar o gerador de mocks: mvn exec:java -Dexec.mainClass=... -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.millenium.agente.mock.MockDataGenerator</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
