<?xml version="1.0" encoding="UTF-8"?>
<!--
  Transporte MCP via stdio: o STDOUT precisa conter APENAS o protocolo JSON-RPC.
  Por isso NAO existe nenhum appender para System.out. O log vai para:
    1) STDERR  -> capturado pelo proprio Claude Desktop em
                  %APPDATA%\Claude\logs\mcp-server-millenium-agente-ia.log
    2) ARQUIVO -> caminho ABSOLUTO e previsivel, independente de qual pasta o
                  Claude Desktop usa como diretorio de trabalho ao lancar o jar:
                  <user.home>/MilleniumAgenteIA/logs/millenium-mcp.log
  Se o servidor falhar ao gerar um .docx/.xlsx, o stack completo aparece nesse
  arquivo (as tools capturam Throwable e chamam log.error).
-->
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- Pasta padronizada do projeto: ${user.home}/MilleniumAgenteIA/logs -->
    <property name="LOG_DIR" value="${user.home}/MilleniumAgenteIA/logs"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/millenium-mcp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/millenium-mcp.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Detalhe das nossas tools (entrada da chamada + stack em caso de falha). -->
    <logger name="com.millenium" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
